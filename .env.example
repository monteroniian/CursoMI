# CursosMi - Environment Variables Template (.env.example)
PORT=3000
NODE_ENV=production

# JWT & Session Secrets
JWT_SECRET=tu_clave_secreta_jwt_para_produccion
SESSION_SECRET=tu_clave_secreta_session_para_produccion

# Admin Production Account Credentials
ADMIN_EMAIL=soporte@cursosmi.com
ADMIN_PASSWORD=TuPasswordAdministradorSeguro2026!

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notificaciones@cursosmi.com
SMTP_PASS=tu_app_password

# Cloud Storage Configuration (Cloudinary / AWS S3)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Mercado Pago API Credentials
MERCADOPAGO_PUBLIC_KEY=tu_public_key_de_mercadopago
MERCADOPAGO_ACCESS_TOKEN=tu_access_token_de_mercadopago
